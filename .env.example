# At least one LLM provider is required for chat/agent features
# ANTHROPIC_API_KEY=sk-ant-xxx
# OPENAI_API_KEY=sk-xxx
# GEMINI_API_KEY=xxx

# Force-enable LLM features in development (bypasses proxy check)
LLMS_ENABLED=true

# Optional: Stripe payments (configure in config/vibes.yml too)
# STRIPE_PUBLIC_KEY=pk_test_xxx
# STRIPE_PRIVATE_KEY=sk_test_xxx

# Optional: Production email via Resend (defaults to Mailbin in dev)
# RESEND_API_KEY=re_xxx

# Optional: production URL/host allowlist. APPLICATION_URL is used for mailer
# links and Host Authorization; APP_HOSTS can include extra comma-separated
# hostnames such as a www domain.
# APPLICATION_URL=https://your-app.example
# APP_HOSTS=www.your-app.example,your-app.fly.dev

# Hosted Ruby on Vibes platform integration (off by default; self-hosters can ignore).
# These are set by the platform when running in vibe-coding mode on Fly — they
# are not used in local development. See docs/vibes-api.md.
# VIBES_API_ENABLED=true        # mounts app/controllers/vibes/api/* routes
# VIBES_API_TOKEN=...           # shared secret; auth fails closed if unset
# USE_MOUNTED_VIBES=true        # opts in to mounted /mnt/data layout (platform-managed)

# Optional: allow embedding in a trusted parent frame. If enabled, every parent
# origin must be listed explicitly.
# EMBED_ALLOW_IFRAME=true
# EMBED_ALLOWLIST=https://your-platform.example

# Optional: override the prefixed-id hash salt. Defaults to the Rails secret key.
# PREFIXED_IDS_SALT=replace-with-a-long-random-value
