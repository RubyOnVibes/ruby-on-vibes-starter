<table border="0" cellpadding="0" cellspacing="0" width="100%">
  <tr>
    <td style="text-align:center;padding-bottom:8px;">
      <div style="color:rgb(<%= vibes_tokens[:text_2] %>);font-size:13px;font-weight:500;letter-spacing:0.5px;text-transform:uppercase;">
        <%= RubyOnVibes.application_name %>
      </div>
    </td>
  </tr>
  <tr>
    <td style="text-align:center;padding-bottom:32px;">
      <h1 style="margin:0;font-size:24px;font-weight:600;line-height:1.3;color:rgb(<%= vibes_tokens[:text_1] %>);">
        You've been invited
      </h1>
    </td>
  </tr>
  <tr>
    <td style="padding:0 0 40px 0;">
      <p style="margin:0;font-size:16px;line-height:1.5;text-align:center;color:rgb(<%= vibes_tokens[:text_2] %>);">
        <strong style="color:rgb(<%= vibes_tokens[:text_1] %>);"><%= @inviter_name %></strong> invited you to join <strong style="color:rgb(<%= vibes_tokens[:text_1] %>);"><%= @workspace.name %></strong>
      </p>
    </td>
  </tr>
  <tr>
    <td align="center" style="padding:0 0 40px 0;">
      <%= link_to "Accept invitation", @accept_url, style: email_button_style(:primary) %>
    </td>
  </tr>
  <tr>
    <td style="padding:24px 0 0 0;border-top:1px solid rgb(<%= vibes_tokens[:surface_3] %>);">
      <p style="margin:0;text-align:center;font-size:13px;line-height:1.5;color:rgb(<%= vibes_tokens[:text_2] %>);">
        If you weren't expecting this, you can safely ignore this email.
      </p>
    </td>
  </tr>
</table>

