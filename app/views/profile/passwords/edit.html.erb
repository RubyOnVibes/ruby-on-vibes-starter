<div class="flex flex-col lg:flex-row min-h-screen">
  <%= render "application/settings_sidebar" %>

  <main class="flex-1 px-4 py-6 sm:px-8 sm:py-10 lg:px-16 lg:py-12">
    <div class="max-w-xl">
      <!-- Header (hidden on mobile where navbar dropdown shows title) -->
      <div class="hidden lg:block mb-10">
        <h1 class="text-2xl font-semibold text-foreground tracking-tight">Password</h1>
      </div>

      <%= form_with(model: current_user, url: profile_password_path, local: true, html: { method: :put }) do |f| %>
        <%= render "error_messages", resource: current_user %>

        <!-- Current Password -->
        <div class="mb-10">
          <h2 class="text-xs font-medium uppercase tracking-wider text-muted-foreground mb-6">Verify identity</h2>
          
          <div>
            <%= f.label :current_password, "Current password", class: "block text-sm font-medium text-foreground mb-2" %>
            <%= f.password_field :current_password, 
                autocomplete: "current-password", 
                class: "w-full px-3 py-2 text-sm text-foreground bg-transparent border border-border rounded-md focus:outline-none focus:ring-2 focus:ring-ring focus:border-transparent transition-shadow" %>
            <p class="text-xs text-muted-foreground mt-2">Required to confirm changes</p>
          </div>
        </div>

        <!-- New Password -->
        <div class="mb-10">
          <h2 class="text-xs font-medium uppercase tracking-wider text-muted-foreground mb-6">New password</h2>
          
          <div class="space-y-5">
            <div>
              <%= f.label :password, "Password", class: "block text-sm font-medium text-foreground mb-2" %>
              <%= f.password_field :password, 
                  autocomplete: "new-password", 
                  class: "w-full px-3 py-2 text-sm text-foreground bg-transparent border border-border rounded-md focus:outline-none focus:ring-2 focus:ring-ring focus:border-transparent transition-shadow" %>
              <% if @minimum_password_length %>
                <p class="text-xs text-muted-foreground mt-2"><%= @minimum_password_length %> characters minimum</p>
              <% end %>
            </div>

            <div>
              <%= f.label :password_confirmation, "Confirm password", class: "block text-sm font-medium text-foreground mb-2" %>
              <%= f.password_field :password_confirmation, 
                  autocomplete: "new-password", 
                  class: "w-full px-3 py-2 text-sm text-foreground bg-transparent border border-border rounded-md focus:outline-none focus:ring-2 focus:ring-ring focus:border-transparent transition-shadow" %>
            </div>
          </div>
        </div>

        <!-- Actions -->
        <div class="flex items-center gap-4 pt-8 border-t border-border">
          <%= f.submit "Save changes", class: "btn btn-sm btn-primary" %>
          <%= link_to "Cancel", :back, class: "text-sm text-muted-foreground hover:text-foreground transition-colors" %>
        </div>
      <% end %>
    </div>
  </main>
</div>
