<div class="max-w-sm sm:max-w-md md:max-w-lg lg:max-w-xl mx-auto">
  <div class="text-center mb-8">
    <h1 class="text-2xl font-bold">Sign up</h1>
    <p class="mt-2 text-sm">Create your account</p>
  </div>

  <% if @invitation %>
    <div class="flex items-center justify-center mb-4 text-center">
      <%= image_tag avatar_url(@invitation.workspace), class: "h-5 w-5 rounded-full inline-block mr-1" %>
      <div>
        <strong><%= @invitation.originator.name %></strong> invited you to join <strong><%= @invitation.workspace.name %></strong>
      </div>
    </div>
  <% end %>

  <%= render "devise/shared/error_messages", resource: resource %>

  <%= form_for(resource, as: resource_name, url: registration_path(resource_name, invite: params[:invite]), class: "space-y-5 md:space-y-6") do |f| %>
    <div>
      <%= f.label :full_name, "Full Name", class: "block text-sm font-medium mb-2 dark:text-white" %>
      <%= f.text_field :full_name,
          autofocus: true,
          autocomplete: "name",
          class: "w-full px-3 py-2 md:px-4 md:py-2.5 border border-input rounded-md focus:outline-none focus:ring-2 focus:ring-ring focus:border-ring text-sm md:text-base",
          placeholder: "Enter your full name" %>
    </div>

    <div>
      <%= f.label :email, class: "block text-sm font-medium mb-2 dark:text-white" %>
      <%= f.email_field :email,
          autocomplete: "email",
          class: "w-full px-3 py-2 md:px-4 md:py-2.5 border border-input rounded-md focus:outline-none focus:ring-2 focus:ring-ring focus:border-ring text-sm md:text-base",
          placeholder: "Enter your email" %>
    </div>

    <%# Alpine.js example - see docs/ada.md → "Alpine.js" section %>
    <div x-data="{ showPassword: false }">
      <%= f.label :password, class: "block text-sm font-medium mb-2" do %>
        Password
        <% if @minimum_password_length %>
          <span class="text-xs">(<%= @minimum_password_length %> characters minimum)</span>
        <% end %>
      <% end %>
      <div style="position: relative; margin-top: 0.75rem;">
        <input type="password"
               :type="showPassword ? 'text' : 'password'"
               name="user[password]"
               id="user_password"
               autocomplete="new-password"
               style="margin-top: 0;"
               class="w-full px-3 py-2 md:px-4 md:py-2.5 pr-10 border border-input rounded-md focus:outline-none focus:ring-2 focus:ring-ring focus:border-ring text-sm md:text-base"
               placeholder="Create a password">
        <button type="button"
                @click="showPassword = !showPassword"
                style="position: absolute; right: 0.75rem; top: 50%; transform: translateY(-50%);"
                class="text-muted-foreground hover:text-foreground focus:outline-none cursor-pointer">
          <%= render "devise/shared/password_toggle_icons" %>
        </button>
      </div>
    </div>

    <div class="mt-2 md:mt-3">
      <%= f.submit "Sign up", 
          class: "w-full py-2 md:py-2.5 px-4 bg-primary hover:bg-primary/90 text-white text-sm md:text-base font-medium rounded-md focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-ring transition-colors" %>
    </div>
  <% end %>

  <%= render "devise/shared/links" %>
</div>
