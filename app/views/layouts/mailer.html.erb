<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<html lang="<%= I18n.locale %>">
<head>
  <meta http-equiv="Content-Type" content="text/html; charset=UTF-8">
  
  <%= render "application/vibes_email_theme" %>
</head>

<body leftmargin="0" marginwidth="0" topmargin="0" marginheight="0" offset="0" style="background-color:rgb(<%= vibes_tokens[:surface_1] %>);">

  <center>
    <table border="0" cellpadding="0" cellspacing="0" height="100%" width="100%">
      <tr>
        <td align="center" valign="top" style="padding:48px 20px;">
          <table border="0" cellpadding="0" cellspacing="0" width="560" style="max-width:560px;">
            
            <!-- Main Content Card -->
            <tr>
              <td align="center" valign="top">
                <table border="0" cellpadding="0" cellspacing="0" width="100%" style="background-color:rgb(<%= vibes_tokens[:surface_0] %>); border-radius:8px;">
                  <tr>
                    <td valign="top" class="bodyContent">
                      <table border="0" cellpadding="0" cellspacing="0" width="100%">
                        <tr>
                          <td valign="top" style="padding:48px 48px 40px 48px;">
                            <%= yield %>
                          </td>
                        </tr>
                      </table>
                    </td>
                  </tr>
                </table>
              </td>
            </tr>
            
            <!-- Footer -->
            <tr>
              <td align="center" valign="top" style="padding-top:40px;">
                <table border="0" cellpadding="0" cellspacing="0" width="100%">
                  <tr>
                    <td valign="top" class="addressContent">
                      <div style="padding:0 20px;">
                        <% if RubyOnVibes.support_email.present? %>
                          <%= link_to RubyOnVibes.support_email, "mailto:#{RubyOnVibes.support_email}", style: "color:rgb(#{vibes_tokens[:text_2]});text-decoration:none;" %>
                          <br style="margin-bottom:6px;">
                        <% end %>
                        © <%= Time.current.year %> <%= RubyOnVibes.business_name %>
                      </div>
                    </td>
                  </tr>
                </table>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </center>
</body>
</html>
