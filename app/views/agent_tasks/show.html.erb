<% content_for(:title, "#{@agent_task.kind.humanize} — Agent Task") %>

<div class="flex flex-col lg:flex-row min-h-screen">
  <%= render "application/settings_sidebar" %>

  <main class="flex-1 px-4 py-6 sm:px-8 sm:py-10 lg:px-16 lg:py-12">
    <div class="max-w-3xl">
      <%# Back link %>
      <div class="mb-6">
        <%= link_to agent_tasks_path, class: "inline-flex items-center gap-1 text-sm hover:underline", style: "color: var(--color-muted-foreground);" do %>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
          </svg>
          Agent Tasks
        <% end %>
      </div>

      <%# Header %>
      <div class="mb-8">
        <div class="flex items-start justify-between gap-4">
          <div>
            <h1 class="text-2xl font-semibold tracking-tight" style="color: var(--color-foreground);">
              <%= @agent_task.kind.humanize %>
            </h1>
            <p class="text-sm mt-1 font-mono" style="color: var(--color-muted-foreground);">
              <%= @agent_task.to_param %>
            </p>
          </div>

          <%# Status badge %>
          <span class="inline-flex items-center gap-1.5 px-3 py-1 text-sm font-medium rounded-full shrink-0"
                style="background-color: var(--color-surface-2); color: var(--color-<%= @agent_task.status_completed? ? 'success' : @agent_task.status_failed? ? 'danger' : 'foreground' %>, var(--color-foreground));">
            <% if @agent_task.active? %>
              <span class="w-2 h-2 rounded-full animate-pulse" style="background-color: var(--color-primary);"></span>
            <% end %>
            <%= @agent_task.status.humanize %>
          </span>
        </div>

        <%# Meta row %>
        <div class="flex flex-wrap gap-x-6 gap-y-1 mt-3 text-sm" style="color: var(--color-muted-foreground);">
          <% if @agent_task.started_at && @agent_task.completed_at %>
            <span>Duration: <%= distance_of_time_in_words(@agent_task.started_at, @agent_task.completed_at) %></span>
          <% elsif @agent_task.started_at %>
            <span>Running for <%= time_ago_in_words(@agent_task.started_at) %></span>
          <% end %>

          <% if @agent_task.attempts > 1 %>
            <span><%= @agent_task.attempts %> attempts</span>
          <% end %>

          <span>
            Started by
            <% if @agent_task.member.respond_to?(:mentionable_label) %>
              <%= @agent_task.member.mentionable_label %>
            <% else %>
              member #<%= @agent_task.member_id %>
            <% end %>
          </span>

          <span>
            Chat:
            <%= link_to @agent_task.chat.mentionable_label.truncate(30),
                  chat_path(@agent_task.chat),
                  class: "hover:underline",
                  style: "color: var(--color-primary);" %>
          </span>

          <% if @agent_task.parent_task.present? %>
            <span>
              Parent:
              <%= link_to @agent_task.parent_task.kind.humanize,
                    agent_task_path(@agent_task.parent_task),
                    class: "hover:underline",
                    style: "color: var(--color-primary);" %>
            </span>
          <% end %>
        </div>

        <%# Progress bar (active tasks) %>
        <% if @agent_task.active? %>
          <div class="mt-4">
            <div class="flex items-center gap-3">
              <div class="flex-1 h-2 rounded-full" style="background-color: var(--color-border);">
                <div class="h-full rounded-full transition-all duration-300" style="width: <%= @agent_task.progress %>%; background-color: var(--color-primary);"></div>
              </div>
              <span class="text-sm font-medium" style="color: var(--color-foreground);"><%= @agent_task.progress %>%</span>
            </div>
            <% if @agent_task.progress_text.present? %>
              <p class="text-xs mt-1" style="color: var(--color-muted-foreground);"><%= @agent_task.progress_text %></p>
            <% end %>
          </div>
        <% end %>
      </div>

      <%# Error message (failed tasks, admin only) %>
      <% if @agent_task.status_failed? && @can_view_errors && @agent_task.error_message.present? %>
        <div class="mb-6 rounded-lg border px-4 py-3" style="border-color: var(--color-danger); background-color: var(--color-surface-1);">
          <div class="flex items-center gap-2 mb-1">
            <svg class="w-4 h-4 shrink-0" style="color: var(--color-danger);" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L4.082 16.5c-.77.833.192 2.5 1.732 2.5z" />
            </svg>
            <span class="text-sm font-medium" style="color: var(--color-danger);">Error</span>
          </div>
          <p class="text-sm font-mono" style="color: var(--color-muted-foreground);"><%= @agent_task.error_message %></p>
        </div>
      <% end %>

      <%# Result section %>
      <% if @agent_task.status_completed? || @agent_task.status_awaiting_approval? %>
        <div class="mb-6">
          <h2 class="text-sm font-medium mb-3" style="color: var(--color-foreground);">
            <%= @agent_task.status_awaiting_approval? ? "Proposed Result" : "Result" %>
          </h2>
          <div class="border rounded-lg p-4" style="border-color: var(--color-border); background-color: var(--color-surface-1);">
            <%# Try kind-specific partial, fall back to default %>
            <%# Sanitize kind to prevent directory traversal (only allow a-z, 0-9, underscores) %>
            <% safe_kind = @agent_task.kind.gsub(/[^a-z0-9_]/, "") %>
            <% partial_name = "agent_tasks/results/#{safe_kind}" %>
            <% if safe_kind.present? && lookup_context.exists?(partial_name, [], true) %>
              <%= render partial: partial_name, locals: { task: @agent_task, result: @agent_task.result } %>
            <% else %>
              <%= render partial: "agent_tasks/results/default", locals: { task: @agent_task, result: @agent_task.result } %>
            <% end %>
          </div>
        </div>
      <% end %>

      <%# Subtasks %>
      <% if @agent_task.subtasks.any? %>
        <div class="mb-6">
          <h2 class="text-sm font-medium mb-3" style="color: var(--color-foreground);">
            Subtasks (<%= @agent_task.subtasks.size %>)
          </h2>
          <div class="border rounded-lg divide-y" style="border-color: var(--color-border); divide-color: var(--color-border);">
            <% @agent_task.subtasks.order(created_at: :asc).each do |subtask| %>
              <div class="px-4 py-3 flex items-center justify-between gap-3">
                <div class="flex items-center gap-2 min-w-0">
                  <% if subtask.active? %>
                    <span class="w-2 h-2 rounded-full animate-pulse shrink-0" style="background-color: var(--color-primary);"></span>
                  <% end %>
                  <%= link_to agent_task_path(subtask),
                        class: "text-sm hover:underline truncate",
                        style: "color: var(--color-primary);" do %>
                    <%= subtask.kind.humanize %>
                  <% end %>
                  <span class="text-xs font-mono" style="color: var(--color-muted-foreground);"><%= subtask.to_param %></span>
                </div>
                <span class="text-xs font-medium shrink-0 px-2 py-0.5 rounded-full"
                      style="background-color: var(--color-surface-2); color: var(--color-<%= subtask.status_completed? ? 'success' : subtask.status_failed? ? 'danger' : 'foreground' %>, var(--color-foreground));">
                  <%= subtask.status.humanize %>
                </span>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>

      <%# Effects timeline %>
      <% if @effects.any? %>
        <div class="mb-6">
          <h2 class="text-sm font-medium mb-3" style="color: var(--color-foreground);">
            Effects (<%= @effects.size %>)
          </h2>
          <div class="border rounded-lg overflow-hidden" style="border-color: var(--color-border);">
            <% @effects.each_with_index do |effect, i| %>
              <div class="<%= 'border-t' if i > 0 %> px-4 py-3 flex items-start gap-3" style="border-color: var(--color-border);">
                <%# Action icon %>
                <span class="mt-0.5 shrink-0">
                  <% case effect.action %>
                  <% when "created" %>
                    <svg class="w-4 h-4" style="color: var(--color-success, var(--color-foreground));" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
                    </svg>
                  <% when "updated" %>
                    <svg class="w-4 h-4" style="color: var(--color-primary);" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                    </svg>
                  <% when "deleted" %>
                    <svg class="w-4 h-4" style="color: var(--color-danger, var(--color-foreground));" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                    </svg>
                  <% when "attached" %>
                    <svg class="w-4 h-4" style="color: var(--color-foreground);" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.172 7l-6.586 6.586a2 2 0 102.828 2.828l6.414-6.586a4 4 0 00-5.656-5.656l-6.415 6.585a6 6 0 108.486 8.486L20.5 13" />
                    </svg>
                  <% when "detached" %>
                    <svg class="w-4 h-4" style="color: var(--color-muted-foreground);" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.172 7l-6.586 6.586a2 2 0 102.828 2.828l6.414-6.586a4 4 0 00-5.656-5.656l-6.415 6.585a6 6 0 108.486 8.486L20.5 13" />
                    </svg>
                  <% when "enqueued" %>
                    <svg class="w-4 h-4" style="color: var(--color-primary);" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
                    </svg>
                  <% else %>
                    <svg class="w-4 h-4" style="color: var(--color-muted-foreground);" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                  <% end %>
                </span>

                <%# Description + meta %>
                <div class="flex-1 min-w-0">
                  <p class="text-sm" style="color: var(--color-foreground);"><%= effect.description %></p>
                  <% if effect.target_type.present? %>
                    <p class="text-xs mt-0.5" style="color: var(--color-muted-foreground);">
                      <% if effect.target.present? %>
                        <% begin %>
                          <%= link_to "#{effect.target_type} #{effect.target.respond_to?(:mentionable_label) ? effect.target.mentionable_label : "##{effect.target_id}"}",
                                polymorphic_path(effect.target),
                                class: "hover:underline",
                                style: "color: var(--color-primary);" %>
                        <% rescue NoMethodError, ActionController::UrlGenerationError %>
                          <%= effect.target_type %> #<%= effect.target_id %>
                        <% end %>
                      <% else %>
                        <%= effect.target_type %> #<%= effect.target_id %> <span class="italic">(deleted)</span>
                      <% end %>
                    </p>
                  <% end %>
                  <%# Show change details for updates %>
                  <% if effect.action == "updated" && effect.details&.dig("changes").present? %>
                    <div class="mt-1 text-xs font-mono" style="color: var(--color-muted-foreground);">
                      <% effect.details["changes"].each do |field, change| %>
                        <span class="inline-block mr-3"><%= field %>: <%= change["from"] %> → <%= change["to"] %></span>
                      <% end %>
                    </div>
                  <% end %>
                  <%# Show file details for attach/detach %>
                  <% if %w[attached detached].include?(effect.action) && effect.details&.dig("filename").present? %>
                    <p class="text-xs mt-0.5 font-mono" style="color: var(--color-muted-foreground);">
                      <%= effect.details["filename"] %>
                      <% if effect.details["byte_size"].present? %>
                        (<%= number_to_human_size(effect.details["byte_size"]) %>)
                      <% end %>
                    </p>
                  <% end %>
                </div>

                <%# Timestamp %>
                <span class="text-xs shrink-0" style="color: var(--color-muted-foreground);">
                  <%= effect.created_at.strftime("%l:%M %p").strip %>
                </span>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>

      <%# Attachments %>
      <% if @agent_task.attachments.any? %>
        <div class="mb-6">
          <h2 class="text-sm font-medium mb-3" style="color: var(--color-foreground);">
            Attachments (<%= @agent_task.attachments.count %>)
          </h2>
          <div class="border rounded-lg divide-y" style="border-color: var(--color-border); divide-color: var(--color-border);">
            <% @agent_task.attachments.each do |attachment| %>
              <div class="px-4 py-3">
                <% if attachment.content_type&.start_with?("image/") %>
                  <%# Inline image preview %>
                  <div class="mb-2">
                    <%= image_tag rails_blob_path(attachment),
                          class: "rounded max-w-full",
                          style: "max-height: 300px; object-fit: contain;",
                          alt: attachment.filename,
                          loading: "lazy" %>
                  </div>
                <% end %>
                <div class="flex items-center justify-between gap-3">
                  <div class="flex items-center gap-2 min-w-0">
                    <svg class="w-4 h-4 shrink-0" style="color: var(--color-muted-foreground);" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z" />
                    </svg>
                    <span class="text-sm truncate" style="color: var(--color-foreground);"><%= attachment.filename %></span>
                    <span class="text-xs" style="color: var(--color-muted-foreground);">(<%= number_to_human_size(attachment.byte_size) %>)</span>
                  </div>
                  <div class="flex items-center gap-3 shrink-0">
                    <% if attachment.content_type&.start_with?("image/") %>
                      <%= link_to "View",
                            rails_blob_path(attachment, disposition: "inline"),
                            class: "text-xs font-medium",
                            style: "color: var(--color-muted-foreground);",
                            target: "_blank" %>
                    <% end %>
                    <%= link_to "Download",
                          rails_blob_path(attachment, disposition: "attachment"),
                          class: "text-xs font-medium",
                          style: "color: var(--color-primary);" %>
                  </div>
                </div>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>

      <%# Raw data (collapsible) %>
      <details class="mb-6">
        <summary class="text-sm font-medium cursor-pointer select-none" style="color: var(--color-muted-foreground);">
          Raw Data
        </summary>
        <div class="mt-3 space-y-3">
          <% if @agent_task.metadata.present? && @agent_task.metadata != {} %>
            <div>
              <p class="text-xs font-medium mb-1" style="color: var(--color-muted-foreground);">Metadata</p>
              <pre class="text-xs font-mono rounded-lg border p-3 overflow-x-auto" style="background-color: var(--color-surface-1); border-color: var(--color-border); color: var(--color-foreground);"><%= JSON.pretty_generate(@agent_task.metadata) %></pre>
            </div>
          <% end %>

          <% if @agent_task.result.present? && @agent_task.result != {} %>
            <div>
              <p class="text-xs font-medium mb-1" style="color: var(--color-muted-foreground);">Result</p>
              <pre class="text-xs font-mono rounded-lg border p-3 overflow-x-auto" style="background-color: var(--color-surface-1); border-color: var(--color-border); color: var(--color-foreground);"><%= JSON.pretty_generate(@agent_task.result) %></pre>
            </div>
          <% end %>

          <div>
            <p class="text-xs font-medium mb-1" style="color: var(--color-muted-foreground);">Timestamps</p>
            <div class="text-xs font-mono rounded-lg border p-3" style="background-color: var(--color-surface-1); border-color: var(--color-border); color: var(--color-foreground);">
              <p>Created: <%= @agent_task.created_at.iso8601 %></p>
              <% if @agent_task.started_at %><p>Started: <%= @agent_task.started_at.iso8601 %></p><% end %>
              <% if @agent_task.completed_at %><p>Completed: <%= @agent_task.completed_at.iso8601 %></p><% end %>
            </div>
          </div>
        </div>
      </details>
    </div>
  </main>
</div>
