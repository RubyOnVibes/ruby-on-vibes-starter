<div class="flex flex-col lg:flex-row min-h-screen">
  <%= render "application/settings_sidebar" %>

  <main class="flex-1 px-4 py-6 sm:px-8 sm:py-10 lg:px-16 lg:py-12">
    <div class="max-w-xl">
      <!-- Breadcrumb -->
      <nav class="flex items-center gap-1.5 text-sm text-muted-foreground mb-8">
        <%= link_to @workspace.name, @workspace, class: "hover:text-foreground transition-colors" %>
        <span class="opacity-40">/</span>
        <span>Invite</span>
      </nav>

      <!-- Header -->
      <div class="mb-10">
        <h1 class="text-2xl font-semibold text-foreground tracking-tight">Invite team member</h1>
        <p class="text-muted-foreground mt-1">They'll receive an email to join <%= @workspace.name %></p>
      </div>

      <%= render 'form', invitation: @invitation %>
    </div>
  </main>
</div>
