<div class="flex flex-col lg:flex-row min-h-screen">
  <%= render "application/settings_sidebar" %>

  <main class="flex-1 px-4 py-6 sm:px-8 sm:py-10 lg:px-16 lg:py-12">
    <div class="max-w-xl">
      <!-- Breadcrumb -->
      <nav class="flex items-center gap-1.5 text-sm text-muted-foreground mb-8">
        <%= link_to @workspace.name, @workspace, class: "hover:text-foreground transition-colors" %>
        <span class="opacity-40">/</span>
        <span>Invitations</span>
      </nav>

      <!-- Header -->
      <div class="mb-10">
        <h1 class="text-2xl font-semibold text-foreground tracking-tight mb-1">Edit invitation</h1>
        <p class="text-muted-foreground">Pending invitation to <%= @invitation.email %></p>
      </div>

      <%= form_with(model: [@workspace, @invitation], url: workspace_invitation_path(@workspace, @invitation), method: :patch) do |form| %>
        <%= render "error_messages", resource: form.object %>

        <!-- Name -->
        <div class="mb-6">
          <%= form.label :name, class: "block text-sm font-medium text-foreground mb-2" do %>Name<% end %>
          <%= form.text_field :name, 
              autofocus: true,
              class: "w-full px-3 py-2 text-sm text-foreground bg-transparent border border-border rounded-md focus:outline-none focus:ring-2 focus:ring-ring focus:border-ring transition-shadow" %>
        </div>

        <!-- Email -->
        <div class="mb-8">
          <%= form.label :email, class: "block text-sm font-medium text-foreground mb-2" do %>Email<% end %>
          <%= form.email_field :email, 
              class: "w-full px-3 py-2 text-sm text-foreground bg-transparent border border-border rounded-md focus:outline-none focus:ring-2 focus:ring-ring focus:border-ring transition-shadow" %>
        </div>

        <!-- Roles -->
        <div class="mb-10">
          <h2 class="text-xs font-medium uppercase tracking-wider text-muted-foreground mb-4">Roles</h2>
          
          <div class="space-y-4">
            <% Member::ROLES.each do |role| %>
              <label class="flex items-start gap-3 cursor-pointer">
                <%= form.check_box role, class: "mt-1 w-4 h-4 rounded border-input dark:border-border text-primary focus:ring-ring focus:ring-offset-0" %>
                <div>
                  <span class="block font-medium text-foreground"><%= role.to_s.titleize %></span>
                  <span class="block text-sm text-muted-foreground leading-relaxed">
                    <% if role == :admin %>
                      Manage workspace settings, billing, and members
                    <% elsif role == :member %>
                      Access workspace resources
                    <% end %>
                  </span>
                </div>
              </label>
            <% end %>
          </div>
        </div>

        <!-- Actions -->
        <div class="flex items-center justify-between pt-8 border-t border-border">
          <div class="flex items-center gap-4">
            <%= form.submit "Save changes", class: "btn btn-sm btn-primary" %>
            <%= link_to "Cancel", @workspace, class: "text-sm text-muted-foreground hover:text-foreground transition-colors" %>
          </div>
          
          <%= button_to workspace_invitation_path(@workspace, @invitation), method: :delete, class: "text-sm text-destructive/60 hover:text-destructive transition-colors", data: { turbo_confirm: "Delete this invitation?" } do %>
            Delete invitation
          <% end %>
        </div>
      <% end %>
    </div>
  </main>
</div>
