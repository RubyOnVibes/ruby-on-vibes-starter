<div class="flex flex-col lg:flex-row min-h-screen">
  <%= render "application/settings_sidebar" %>

  <!-- Main content -->
  <main class="flex-1 px-4 py-4 sm:px-6 sm:py-6 lg:px-12 lg:py-6">
    <div class="max-w-4xl">
      <!-- Breadcrumb -->
      <div class="flex items-center gap-2 mb-3">
        <%= link_to @workspace.name, @workspace, class: "v-link-muted text-sm" %>
        <%= chevron_right_icon(class: "w-4 h-4 text-muted-foreground") %>
        <span class="text-sm text-muted-foreground">Edit Settings</span>
      </div>

      <!-- Header with delete button -->
      <div class="flex items-center mb-6">
        <h1 class="hidden lg:block v-page-heading text-foreground mb-0">Workspace Settings</h1>
        <% if !@workspace.personal? %>
          <div class="ml-auto">
            <%= button_to "Delete", @workspace, {
              method: :delete, 
              class: "btn btn-destructive-outline text-sm",
              data: { 
                turbo_confirm: "Are you sure?", 
                turbo_confirm_description: subscribed? ? "This Workspace has an active subscription. It will be cancelled." : "This will permanently delete this Workspace." 
              } 
            } %>
          </div>
        <% end %>
      </div>

      <%= render "form", workspace: @workspace %>
    </div>
  </main>
</div>