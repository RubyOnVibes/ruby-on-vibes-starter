<%= form_with(model: workspace) do |form| %>
  <%= render "error_messages", resource: form.object %>

  <!-- Avatar -->
  <div class="flex items-center gap-5 mb-10">
    <div id="avatar-preview-container">
      <%= workspace_avatar form.object, css_class: "w-16 h-16", pixel_size: 64 %>
    </div>
    <div>
      <%= form.file_field :avatar, 
          id: "avatar-input",
          accept: "image/*",
          class: "text-sm text-muted-foreground file:mr-3 file:py-1.5 file:px-3 file:rounded-md file:border file:border-border file:text-sm file:font-medium file:bg-transparent file:text-foreground file:cursor-pointer hover:file:bg-surface-1 file:transition-colors" %>
      <p class="text-xs text-muted-foreground mt-2">JPG, PNG, or GIF</p>
    </div>
  </div>

  <!-- Details -->
  <div class="mb-10">
    <h2 class="text-xs font-medium uppercase tracking-wider text-muted-foreground mb-6">Details</h2>
    
    <div>
      <%= form.label :name, "Name", class: "block text-sm font-medium text-foreground mb-2" %>
      <%= form.text_field :name, 
          autofocus: true,
          class: "w-full px-3 py-2 text-sm text-foreground bg-transparent border border-border rounded-md focus:outline-none focus:ring-2 focus:ring-ring focus:border-transparent transition-shadow" %>
      <p class="text-xs text-muted-foreground mt-2">Visible to all team members</p>
    </div>
  </div>

  <!-- Actions -->
  <div class="flex items-center gap-4 pt-8 border-t border-border">
    <%= form.submit form.object.persisted? ? "Save changes" : "Create workspace", class: "btn btn-sm btn-primary" %>
    <%= link_to "Cancel", workspaces_path, class: "text-sm text-muted-foreground hover:text-foreground transition-colors" %>
  </div>
<% end %>

<%= render "shared/turbo_script" do %>
  const input = document.getElementById('avatar-input');
  const container = document.getElementById('avatar-preview-container');
  
  if (!input || !container) return;
  
  function previewAvatar(e) {
    const file = e.target.files?.[0];
    if (!file) return;
    
    const reader = new FileReader();
    reader.onload = (event) => {
      container.innerHTML = `<img src="${event.target.result}" alt="Avatar preview" class="w-16 h-16 rounded-full object-cover">`;
    };
    reader.readAsDataURL(file);
  }
  
  input.addEventListener('change', previewAvatar);
  
  return () => {
    input.removeEventListener('change', previewAvatar);
  };
<% end %>
