<div class="mt-12 flex items-center justify-center px-4 py-12">
  <div class="w-full max-w-md bg-surface-1 rounded-xl border border-border p-8 shadow-sm">
    <div class="text-center mb-8">
      <%= image_tag avatar_url(@invitation.workspace), class: "h-16 w-16 rounded-full mx-auto mb-4" %>
      <h1 class="text-3xl font-semibold text-foreground mb-2">Join <%= @invitation.workspace.name %></h1>
      <p class="text-muted-foreground">
        <%= @invitation.originator.name %> invited you to join <%= @invitation.workspace.name %>
      </p>
    </div>

    <div class="flex justify-between">
      <%= button_to t(".accept"), invitation_path(@invitation.token), method: :put, class: "btn btn-primary flex-1" %>
      <%= button_to t(".decline"), invitation_path(@invitation.token), method: :delete, class: "btn btn-secondary flex-1", data: {turbo_confirm: t("are_you_sure")} %>
    </div>
  </div>
</div>