<div class="flex flex-col lg:flex-row min-h-screen">
  <%= render "application/settings_sidebar" %>

  <!-- Main content -->
  <main class="flex-1 px-4 py-4 sm:px-6 sm:py-6 lg:px-12 lg:py-6">
    <div class="max-w-2xl">
      <!-- Breadcrumb -->
      <div class="flex items-center gap-2 mb-3">
        <%= link_to "Billing Plan", payments_path, class: "v-link-muted text-sm" %>
        <%= chevron_right_icon(class: "w-4 h-4 text-muted-foreground") %>
        <span class="text-sm text-muted-foreground"><%= t ".title" %></span>
      </div>

      <h1 class="v-page-heading text-foreground mb-6">Pause Subscription</h1>

      <!-- Information -->
      <div class="space-y-3 mb-8 text-muted-foreground">
        <p>Pausing your subscription will stop all billing temporarily.</p>
        <p>You can resume your subscription at any time from your billing page.</p>
      </div>

      <!-- Actions -->
      <div class="flex flex-col-reverse sm:flex-row gap-3 sm:justify-between sm:items-center pt-6 border-t border-border">
        <%= link_to "Back", payments_path, class: "btn btn-secondary w-full sm:w-auto" %>

        <%= button_to "Pause Subscription", pause_payments_subscription_path(@subscription), method: :patch, class: "btn btn-primary w-full sm:w-auto", data: { turbo_confirm: "Are you sure you want to pause your subscription?" } %>
      </div>
    </div>
  </main>
</div>
