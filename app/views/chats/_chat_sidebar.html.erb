<%# Shared chat sidebar for index and show pages %>
<div id="mobile-sidebar" class="chat-sidebar chat-sidebar-mobile fixed left-0 z-50 w-64 flex flex-col" style="top: 0; bottom: 0; height: 100vh;" data-sidebar>
  <%# Mobile-only header with profile and close - at very top, tall enough to align "New chat" with chat header %>
  <div class="lg:hidden flex-shrink-0 flex items-center justify-between px-3" style="border-bottom: 1px solid var(--color-border); height: 64px;">
    <a href="<%= edit_profile_registration_path %>" 
       class="p-2 rounded-lg hover:opacity-70 transition -ml-2"
       onclick="closeChatSidebar()"
       style="color: var(--color-foreground);"
       aria-label="Profile">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
      </svg>
    </a>
    
    <button 
      type="button"
      onclick="closeChatSidebar()"
      class="p-2 rounded-lg hover:opacity-70 transition -mr-2"
      style="color: var(--color-foreground);"
      aria-label="Close sidebar">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>
  
  <div class="flex-shrink-0 px-3 flex items-center" style="border-bottom: 1px solid var(--color-border); height: 53px;">
    <%= button_to chats_path, method: :post, 
        class: "new-chat-btn w-full flex items-center justify-center gap-2 px-3 py-2 rounded-lg transition cursor-pointer",
        onclick: "closeChatSidebar()" do %>
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
      <span class="text-sm font-medium">New chat</span>
    <% end %>
  </div>
  
  <div class="flex-1 min-h-0 overflow-y-auto overflow-x-visible px-2 pb-2 chat-sidebar-list" style="position: relative;">
    <%# Collect agent chat IDs to exclude from regular chat lists %>
    <% agent_chat_ids = RubyOnVibes.agents? ? (current_workspace&.agents&.pluck(:chat_id) || []) : [] %>

    <%# === Agents Section === %>
    <% agents = RubyOnVibes.agents? ? (current_workspace&.agents&.active&.order(:name) || []) : [] %>
    <% if agents.any? %>
      <div data-sidebar-section="agents">
        <button type="button" onclick="toggleSidebarSection('agents')" class="sidebar-section-toggle w-full flex items-center justify-between px-3 pt-3 pb-1.5 cursor-pointer group">
          <h3 class="text-xs font-semibold uppercase tracking-wide opacity-60 group-hover:opacity-80 transition">Agents</h3>
          <svg class="sidebar-chevron w-3 h-3 opacity-40 group-hover:opacity-60 transition" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
          </svg>
        </button>
        <div class="sidebar-section-content">
          <% agents.each do |agent| %>
            <% agent_chat = agent.chat %>
            <% is_active = local_assigns[:active_chat_id].present? && local_assigns[:active_chat_id] == agent_chat.id %>
            <%= link_to chat_path(agent_chat),
                class: "chat-list-item block px-3 py-2 mb-0.5 rounded-md text-sm truncate transition #{'active' if is_active}",
                onclick: "closeChatSidebar()" do %>
              <%= agent.name %>
            <% end %>
          <% end %>
        </div>
      </div>
    <% end %>

    <%# === Chat Invitations === %>
    <% pending_invitations = current_member.pending_chat_invitations.limit(5) %>
    <% if pending_invitations.any? %>
      <div class="mb-2">
        <div class="px-3 pt-3 pb-1.5">
          <h3 class="text-xs font-semibold uppercase tracking-wide opacity-60">Chat Invitations</h3>
        </div>
        <% pending_invitations.each do |invitation| %>
          <% is_active = local_assigns[:active_invitation_id] == invitation.id %>
          <%= link_to chat_invitation_path(id: invitation.id),
              class: "chat-list-item block px-3 py-2 mb-0.5 rounded-md text-sm transition #{'active' if is_active}",
              onclick: "closeChatSidebar()" do %>
            <div class="truncate font-medium">
              <%= invitation.chat.name %>
            </div>
            <div class="text-xs mt-0.5 opacity-70 truncate">
              from <%= invitation.inviter.user.name %>
            </div>
          <% end %>
        <% end %>
      </div>
    <% end %>

    <%# === Group Chats (exclude agent chats) === %>
    <% group_chats = current_member.chats.with_multiple_members.where.not(id: agent_chat_ids).order(updated_at: :desc).limit(10) %>
    <% if group_chats.any? %>
      <div data-sidebar-section="group-chats">
        <button type="button" onclick="toggleSidebarSection('group-chats')" class="sidebar-section-toggle w-full flex items-center justify-between px-3 pt-3 pb-1.5 cursor-pointer group">
          <h3 class="text-xs font-semibold uppercase tracking-wide opacity-60 group-hover:opacity-80 transition">Group chats</h3>
          <svg class="sidebar-chevron w-3 h-3 opacity-40 group-hover:opacity-60 transition" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
          </svg>
        </button>
        <div class="sidebar-section-content">
          <% group_chats.each do |chat_item| %>
            <div id="chat-sidebar-item-<%= chat_item.to_param %>"
                 data-initial-state='<%= {
                   chatId: chat_item.to_param,
                   chatName: chat_item.name.presence || chat_item.messages.where(role: :user).first&.content&.truncate(35) || "New chat",
                   isActive: (local_assigns[:active_chat_id].present? && local_assigns[:active_chat_id] == chat_item.id),
                   chatPath: chat_path(chat_item),
                   isOwner: chat_item.owner?(current_member),
                   isGroupChat: true,
                   canLeave: !chat_item.owner?(current_member)
                 }.to_json %>'>
              <%= react_component "ChatSidebarIsland", {
                containerId: "chat-sidebar-item-#{chat_item.to_param}"
              }, {
                container_id: "chat-sidebar-item-#{chat_item.to_param}"
              } %>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>

    <%# === Personal Chats (exclude agent chats) === %>
    <% personal_chats = current_member.chats.personal.where.not(id: agent_chat_ids).order(updated_at: :desc).limit(20) %>
    <% if personal_chats.any? %>
      <div data-sidebar-section="your-chats">
        <button type="button" onclick="toggleSidebarSection('your-chats')" class="sidebar-section-toggle w-full flex items-center justify-between px-3 pt-3 pb-1.5 cursor-pointer group">
          <h3 class="text-xs font-semibold uppercase tracking-wide opacity-60 group-hover:opacity-80 transition">Your chats</h3>
          <svg class="sidebar-chevron w-3 h-3 opacity-40 group-hover:opacity-60 transition" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
          </svg>
        </button>
        <div class="sidebar-section-content">
          <% personal_chats.each do |chat_item| %>
            <div id="chat-sidebar-item-<%= chat_item.to_param %>"
                 data-initial-state='<%= {
                   chatId: chat_item.to_param,
                   chatName: chat_item.name.presence || chat_item.messages.where(role: :user).first&.content&.truncate(35) || "New chat",
                   isActive: (local_assigns[:active_chat_id].present? && local_assigns[:active_chat_id] == chat_item.id),
                   chatPath: chat_path(chat_item),
                   isOwner: chat_item.owner?(current_member),
                   isGroupChat: false,
                   canLeave: false
                 }.to_json %>'>
              <%= react_component "ChatSidebarIsland", {
                containerId: "chat-sidebar-item-#{chat_item.to_param}"
              }, {
                container_id: "chat-sidebar-item-#{chat_item.to_param}"
              } %>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>

  <div class="flex-shrink-0">
  <%= render "application/user_workspace_footer", nonce: local_assigns[:nonce] %>
  </div>
</div>
