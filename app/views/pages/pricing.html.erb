<div class="container m-auto py-20 px-4">
  <!-- Header Section -->
  <div class="flex flex-wrap justify-center mb-16">
    <div class="text-center max-w-3xl">
      <h1 class="text-5xl sm:text-6xl font-bold tracking-tight text-foreground mb-6">
        Pricing Plans
      </h1>
      <p class="text-xl sm:text-2xl text-muted-foreground leading-relaxed font-medium">
        Choose the perfect plan for your needs
      </p>
    </div>
  </div>

  <div x-data="{ activeInterval: '<%= @initial_interval %>' }">
      <!-- Interval Toggle -->
      <% if @available_intervals.length > 1 %>
      <div class="flex justify-center mb-12">
        <div class="inline-flex bg-surface-2 rounded-full p-1">
          <% @available_intervals.each do |interval| %>
            <% interval_label = interval == 'month' ? 'Monthly' : 'Yearly' %>
            <button
              type="button"
              @click="activeInterval = '<%= interval %>'"
              :class="activeInterval === '<%= interval %>' ? 'shadow-sm text-foreground bg-surface-0 border-border border hover:text-foreground' : 'text-muted-foreground hover:text-foreground'"
              class="relative cursor-pointer px-8 py-3 text-sm font-semibold whitespace-nowrap rounded-full focus:outline-hidden focus:z-10 transition-all duration-200"
            >
              <%= interval_label %>
            </button>
          <% end %>
        </div>
        </div>
      <% end %>

      <!-- Plans Container -->
      <div class="w-full">
        <% @available_intervals.each do |interval| %>
          <div x-show="activeInterval === '<%= interval %>'" x-transition:enter="transition ease-out duration-200" x-transition:enter-start="opacity-0" x-transition:enter-end="opacity-100">
            <div class="flex flex-wrap items-stretch justify-center -mx-4">
              <% current_plans = @grouped_plans_data[interval] || [] %>
              <% current_plans.each do |plan| %>
                <div class="lg:w-1/3 w-full p-10 bg-card border-card border hover:border-primary m-4 rounded-2xl shadow-sm hover:shadow-lg transition-all duration-300 group">
                  <!-- Plan Name -->
                  <h4 class="mb-8 text-2xl font-semibold tracking-tight text-foreground">
                    <%= plan[:name] %>
                  </h4>

                  <!-- Price -->
                  <div class="mb-8 pb-8 border-b border-border">
                    <% if plan[:contact_url].present? %>
                      <span class="text-5xl font-bold tracking-tight text-foreground">
                        Contact Us
                      </span>
                    <% else %>
                      <div class="flex items-baseline gap-2">
                        <span class="text-5xl font-bold tracking-tight text-foreground">
                          <%= number_to_currency(plan[:amount] / 100.0, unit: plan[:currency].upcase == 'USD' ? '$' : plan[:currency].upcase, precision: plan[:amount] % 100 == 0 ? 0 : 2) %>
                        </span>
                        <span class="text-lg text-muted-foreground font-medium">
                          <% if plan[:unit_label].present? %>
                            / <%= plan[:unit_label] %> 
                          <% end %>/ <%= plan[:interval_count] > 1 ? "#{plan[:interval_count]} #{plan[:interval]}s" : plan[:interval] %>
                        </span>
                      </div>
                    <% end %>
                  </div>

                  <!-- Description -->
                  <% if plan[:description].present? %>
                    <p class="mb-8 text-base leading-relaxed text-muted-foreground">
                      <%= plan[:description] %>
                    </p>
                  <% end %>

                  <!-- Features -->
                  <div class="mb-10 space-y-4">
                    <% (plan[:features] || []).each do |feature| %>
                      <div class="flex items-start gap-3 text-foreground">
                        <svg
                          xmlns="http://www.w3.org/2000/svg"
                          class="shrink-0 mt-0.5 text-primary h-5 w-5"
                          viewBox="0 0 20 20"
                          fill="currentColor"
                        >
                          <path
                            fill-rule="evenodd"
                            d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                            clip-rule="evenodd"
                          />
                        </svg>
                        <div class="text-base"><%= feature %></div>
                      </div>
                    <% end %>
                  </div>

                  <!-- CTA Button -->
                  <% if plan[:contact_url].present? %>
                    <a
                      href="<%= plan[:contact_url] %>"
                      class="btn btn-secondary btn-large btn-block"
                    >
                      Contact Us
                    </a>
                  <% else %>
                    <a
                      href="<%= plan[:checkout_path] %>"
                      class="btn btn-secondary btn-large btn-block"
                    >
                      <%= plan[:trial_period] ? 'Start Free Trial' : 'Get Started' %>
                    </a>
                  <% end %>
                </div>
              <% end %>
            </div>
          </div>
        <% end %>
    </div>
  </div>
</div>