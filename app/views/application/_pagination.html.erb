<% if pagy.last > 1 %>
  <nav class="flex items-center justify-between" aria-label="Pagination">
    <p class="hidden sm:block text-sm text-muted-foreground">
      Showing <span class="font-medium text-foreground"><%= pagy.from %></span>
      to <span class="font-medium text-foreground"><%= pagy.to %></span>
      of <span class="font-medium text-foreground"><%= pagy.count %></span> results
    </p>

    <div class="flex items-center gap-1">
      <% if pagy.previous %>
        <%= link_to url_for(page: pagy.previous), class: "inline-flex items-center justify-center w-9 h-9 rounded-md bg-surface-1 text-foreground hover:bg-surface-2 transition-colors" do %>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
          </svg>
        <% end %>
      <% else %>
        <span class="inline-flex items-center justify-center w-9 h-9 rounded-md text-muted-foreground opacity-50 cursor-not-allowed">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
          </svg>
        </span>
      <% end %>

      <%
        # Smart pagination: show first, last, and window around current
        # Mobile: 1 page each side, Desktop: 2 pages each side
        current = pagy.page
        last_page = pagy.last
        mobile_window = 1
        desktop_window = 2
        
        # Build page list with :gap markers
        def build_pages(current, last_page, window)
          pages = []
          (1..last_page).each do |p|
            in_window = (p - current).abs <= window
            is_edge = p == 1 || p == last_page
            if in_window || is_edge
              pages << p
            elsif pages.last != :gap
              pages << :gap
            end
          end
          pages
        end
        
        mobile_pages = build_pages(current, last_page, mobile_window)
        desktop_pages = build_pages(current, last_page, desktop_window)
      %>
      
      <% mobile_pages.each do |item| %>
        <% if item == :gap %>
          <span class="sm:hidden inline-flex items-center justify-center w-9 h-9 text-sm text-muted-foreground">…</span>
        <% elsif item == current %>
          <span class="sm:hidden inline-flex items-center justify-center w-9 h-9 rounded-md text-sm font-medium bg-primary text-foreground">
            <%= item %>
          </span>
        <% else %>
          <%= link_to item, url_for(page: item), class: "sm:hidden inline-flex items-center justify-center w-9 h-9 rounded-md text-sm font-medium bg-surface-1 text-foreground hover:bg-surface-2 transition-colors" %>
        <% end %>
      <% end %>
      
      <% desktop_pages.each do |item| %>
        <% if item == :gap %>
          <span class="hidden sm:inline-flex items-center justify-center w-9 h-9 text-sm text-muted-foreground">…</span>
        <% elsif item == current %>
          <span class="hidden sm:inline-flex items-center justify-center w-9 h-9 rounded-md text-sm font-medium bg-primary text-foreground">
            <%= item %>
          </span>
        <% else %>
          <%= link_to item, url_for(page: item), class: "hidden sm:inline-flex items-center justify-center w-9 h-9 rounded-md text-sm font-medium bg-surface-1 text-foreground hover:bg-surface-2 transition-colors" %>
        <% end %>
      <% end %>

      <% if pagy.next %>
        <%= link_to url_for(page: pagy.next), class: "inline-flex items-center justify-center w-9 h-9 rounded-md bg-surface-1 text-foreground hover:bg-surface-2 transition-colors" do %>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        <% end %>
      <% else %>
        <span class="inline-flex items-center justify-center w-9 h-9 rounded-md text-muted-foreground opacity-50 cursor-not-allowed">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </span>
      <% end %>
    </div>
  </nav>
<% end %>
